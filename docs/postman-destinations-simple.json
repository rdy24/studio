					"raw": "{\n  \"name\": \"New York\",\n  \"country\": \"USA\",\n  \"description\": \"The Big Apple, a city that never sleeps.\",\n  \"image_url\": \"https://placehold.co/600x400.png?text=NewYork\"\n}"
